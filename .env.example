# Primary LLM API Key (OpenRouter / Free-tier rotation)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Extra keys for rotation on rate-limit / quota exhaustion. Any env var listed in
# a ModelConfig's `api_key_env_vars` may hold several comma-separated keys.
OPENROUTER_API_KEYS=

# Alternative / Fallback Provider API Keys (referenced by ModelConfig.fallbacks)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEYS=

# Optional Default Provider Configuration
DEFAULT_MODEL_NAME=qwen/qwen3-235b-a22b-2507
DEFAULT_PROVIDER_URL=https://openrouter.ai/api/v1
